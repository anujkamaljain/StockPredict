# =============================================================================
# Stock Market ML Decision Support System - Environment Configuration
# =============================================================================
# Copy this file to backend/.env and fill in your values

# ============ API Keys ============
# 🥇 PRIMARY data source — official API, stable
# Get yours free at: https://www.alphavantage.co/support/
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# 📊 Macroeconomic data (interest rates, inflation, GDP, VIX)
# Get yours free at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# 🥈 Yahoo Finance — no key needed (automatic fallback via yfinance library)

# ============ Database ============
DATABASE_URL=sqlite:///./data/market_data.db

# ============ Data Storage ============
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODEL_DIR=./data/models
CACHE_DIR=./data/cache

# ============ Model Configuration ============
DEVICE=cpu
BATCH_SIZE=64
LEARNING_RATE=0.001
EPOCHS=100
SEQUENCE_LENGTH=60
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15

# ============ Trading Configuration ============
INITIAL_CAPITAL=100000
TRANSACTION_COST_PCT=0.001
SLIPPAGE_PCT=0.0005
MAX_POSITION_PCT=0.1
RISK_FREE_RATE=0.05

# ============ API Server ============
API_HOST=0.0.0.0
API_PORT=8000

# ============ Frontend ============
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============ Production (set when deploying) ============
# FRONTEND_URL=https://your-project.vercel.app
